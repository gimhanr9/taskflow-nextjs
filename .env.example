# Database connection string (PostgreSQL)
# e.g. for Neon / Supabase / Railway: postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL="postgresql://postgres:root@localhost:5432/taskflow?schema=public"

# Authentication secret for JWT cookie session encoding (min 32 chars)
JWT_SECRET="taskflow_jwt_secret_key_production_grade_32_characters_minimum"

# Application base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
